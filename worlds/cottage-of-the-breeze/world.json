    "warden:key-warden:c0": "the Key Warden has given what it gives (Section 1, first pass)"
  },
  "rules": [
    {
      "id": "the-letter-read",
      "when": {
        "reads": {
          "what": "a-letter-in-a-chest"
        }
      },
      "then": [
        {
          "set": "read-the-letter"
        },
        {
          "say": "You fold it small again. Someone in town ought to hear about this."
        }
      ],
      "once": true
    },
    {
      "id": "the-keeper-knows",
      "when": {
        "comes-near": {
          "who": "keeper",
          "distance": 1
        }
      },
      "if": [
        {
          "flag": "read-the-letter",
          "is": true
        }
      ],
      "then": [
        {
          "set": "keeper-came-back"
        },
        {
          "say": {
            "who": "keeper",
            "line": "Oh. You found his letter. He did say he'd come back. Here, I kept one back for you."
          }
        }
      ],
      "once": true
    },
    {
      "id": "the-seal-note-read",
      "when": {
        "reads": {
          "what": "a-note-for-the-next-one-down"
        }
      },
      "once": true,
      "then": [
        {
          "set": "act-1-complete"
        },
        {
          "complete-act": "act-1"
        },
        {
          "say": "Far above, a window is a little brighter than it was."
        }
      ]
    },
    {
      "id": "tutorial-begin",
      "when": {
        "starts": {}
      },
      "then": [
        {
          "say": "Walk with the arrow keys, W A S D, or the joystick. F does whatever the big button says. The stair is in the top left corner of your kitchen, where you make tea."
        }
      ],
      "once": true
    },
    {
      "id": "the-cat-notices",
      "when": {
        "comes-near": {
          "who": "hearth-cat",
          "distance": 1
        }
      },
      "then": [
        {
          "say": "The cat looks up, blinks slowly, and goes back to its nap."
        }
      ],
      "once": true
    },
    {
      "id": "keeper-after-the-end",
      "when": {
        "comes-near": {
          "who": "keeper",
          "distance": 1
        }
      },
      "then": [
        {
          "say": {
            "who": "keeper",
            "line": "You came back up. I thought you might. Sit by the fire; I will find you something sweet."
          }
        }
      ],
      "once": true,
      "if": [
        {
          "flag": "act-1-complete",
          "is": true
        }
      ]
    },
    {
      "id": "regular-after-the-end",
      "when": {
        "comes-near": {
          "who": "tavern-regular",
          "distance": 1
        }
      },
      "then": [
        {
          "say": {
            "who": "tavern-regular",
            "line": "Funny. The cold in here is not as sharp as it was. Sit, if you like."
          }
        }
      ],
      "once": true,
      "if": [
        {
          "flag": "act-1-complete",
          "is": true
        }
      ]
    },
    {
      "id": "dwarf-smith-after-the-end",
      "when": {
        "comes-near": {
          "who": "dwarf-smith",
          "distance": 1
        }
      },
      "then": [
        {
          "say": {
            "who": "dwarf-smith",
            "line": "Banked it at three, same as always. Don't ask. There's a stool by it, if you're cold."
          }
        }
      ],
      "once": true,
      "if": [
        {
          "flag": "act-1-complete",
          "is": true
        }
      ]
    },
    {
      "id": "fisher-after-the-end",
      "when": {
        "comes-near": {
          "who": "fisher",
          "distance": 1
        }
      },
      "then": [
        {
          "say": {
            "who": "fisher",
            "line": "Oren went down that stair once. He didn't come up. You did. Mind how you go."
          }
        }
      ],
      "once": true,
      "if": [
        {
          "flag": "act-1-complete",
          "is": true
        }
      ]
    },
    {
      "id": "gardener-after-the-end",
      "when": {
        "comes-near": {
          "who": "gardener",
          "distance": 1
        }
      },
      "then": [
        {
          "say": {
            "who": "gardener",
            "line": "Here, take a seedling. No, really. Nobody else will."
          }
        }
      ],
      "once": true,
      "if": [
        {
          "flag": "act-1-complete",
          "is": true
        }
      ]
    },
    {
      "id": "trader-after-the-end",
      "when": {
        "comes-near": {
          "who": "vendor",
          "distance": 1
        }
      },
      "then": [
        {
          "say": {
            "who": "vendor",
            "line": "Folk are stopping to talk at the stall again. I still don't ask where a thing came from."
          }
        }
      ],
      "once": true,
      "if": [
        {
          "flag": "act-1-complete",
          "is": true
        }
      ]
    },
    {
      "id": "hearth-cat-after-the-end",
      "when": {
        "comes-near": {
          "who": "hearth-cat",
          "distance": 1
        }
      },
      "then": [
        {
          "say": {
            "who": "hearth-cat",
            "line": "Mrrp. (The cat moves one paw toward the hearth and leaves its eyes shut.)"
          }
        }
      ],
      "once": true,
      "if": [
        {
          "flag": "act-1-complete",
          "is": true
        }
      ]
    },
    {
      "id": "key-warden-yields",
      "when": {
        "reads": {
          "what": "a-note-for-the-next-one-down"
        }
      },
      "then": [
        {
          "set": "warden:key-warden:c0"
        },
        {
          "say": "It gives you what it gives."
        }
      ],
      "once": true
    },
    {
      "id": "the-pale-moth-gives",
      "when": {
        "reads": {
          "what": "the-pale-moth"
        }
      },
      "then": [
        {
          "give": "lantern-key"
        }
      ],
      "once": true
    },
    {
      "id": "the-old-mushroom-gives",
      "when": {
        "reads": {
          "what": "the-old-mushroom"
        }
      },
      "then": [
        {
          "give": "bell-key"
        }
      ],
      "once": true
    },
    {
      "id": "the-stag-beetle-gives",
      "when": {
        "reads": {
          "what": "the-stag-beetle"
        }
      },
      "then": [
        {
          "give": "helmet-key"
        }
      ],
      "once": true
    }
  ],
