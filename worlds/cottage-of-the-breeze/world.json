  "flags": {
    "read-the-letter": "The hero has read the letter from the chest on the first cellar floor.",
    "keeper-came-back": "The Spell Keeper has told the hero the letter is hers.",
    "act-1-complete": "the note under the Cellar King's seal has been read"
  },
  "rules": [
    {
      "id": "the-letter-read",
      "when": {
        "reads": {
          "what": "a-letter-in-a-chest"
        }
      },
      "then": [
        {
          "set": "read-the-letter"
        },
        {
          "say": "You fold it small again. Someone in town ought to hear about this."
        }
      ],
      "once": true
    },
    {
      "id": "the-keeper-knows",
      "when": {
        "comes-near": {
          "who": "keeper",
          "distance": 1
        }
      },
      "if": [
        {
          "flag": "read-the-letter",
          "is": true
        }
      ],
      "then": [
        {
          "set": "keeper-came-back"
        },
        {
          "say": {
            "who": "keeper",
            "line": "Oh. You found my letter. I did say I'd come back. I only took the long way round. Here, I kept one back for you."
          }
        }
      ],
      "once": true
    },
    {
      "id": "the-seal-note-read",
      "when": {
        "reads": {
          "what": "a-note-under-the-seal"
        }
      },
      "once": true,
      "then": [
        {
          "set": "act-1-complete"
        },
        {
          "complete-act": "act-1"
        },
        {
          "say": "Far above, a window is a little brighter than it was."
        }
      ]
    },
    {
      "id": "tutorial-begin",
      "when": {
        "starts": {}
      },
      "then": [
        {
          "say": "Walk with the arrow keys or W A S D. E does whatever the big button says. The stair is in the town's top left corner."
        }
      ],
      "once": true
    },
    {
      "id": "the-cat-notices",
      "when": {
        "comes-near": {
          "who": "hearth-cat",
          "distance": 1
        }
      },
      "then": [
        {
          "say": "The cat looks up, blinks slowly, and goes back to its nap."
        }
      ],
      "once": true
    },
    {
      "id": "keeper-after-the-end",
      "when": {
        "comes-near": {
          "who": "keeper",
          "distance": 1
        }
      },
      "then": [
        {
          "say": {
            "who": "keeper",
            "line": "You came back up. I thought you might. Sit by the fire; I will find you something sweet."
          }
        }
      ],
      "once": true,
      "if": [
        {
          "flag": "act-1-complete",
          "is": true
        }
      ]
    },
    {
      "id": "regular-after-the-end",
      "when": {
        "comes-near": {
          "who": "tavern-regular",
          "distance": 1
        }
      },
      "then": [
        {
          "say": {
            "who": "tavern-regular",
            "line": "Funny. The cold in here is not as sharp as it was. Sit, if you like."
          }
        }
      ],
      "once": true,
      "if": [
        {
          "flag": "act-1-complete",
          "is": true
        }
      ]
    }
  ],
